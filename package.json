{
  "name": "dom-sink-review",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "Bounded offline source-policy review of declared HTML sinks and sanitizer bindings",
  "license": "MPL-2.0",
  "engines": {
    "node": ">=22 <27"
  },
  "bin": {
    "dom-sink-review": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/review.mjs"
  },
  "dependencies": {
    "acorn": "8.15.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "files": [
    "src",
    "examples",
    "test",
    "项目文档/LICENSE",
    "项目文档/NOTICE",
    "项目文档/README.md",
    "项目文档/ORIGIN.md",
    "项目文档/DEFENSIVE_SCOPE.md",
    "项目文档/DEPENDENCIES.md",
    "项目文档/VALIDATION.md",
    "项目文档/SOURCE_REVIEW.json",
    "项目文档/SOURCE_AUDIT.json",
    "SOURCE_REVIEW_MANIFEST.json",
    "项目文档/third_party",
    ".github",
    "项目文档/third_party/acorn/LICENSE"
  ],
  "author": "dhtfish98",
  "maintainers": [
    {
      "name": "dhtfish98"
    }
  ]
}
